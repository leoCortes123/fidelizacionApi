# Variables para operaciones manuales con Supabase CLI.
# No versiones valores reales. En local, `supabase login` guarda el token fuera del repo.

# Referencia del proyecto alojado (la encuentras en la URL del panel de Supabase).
SUPABASE_PROJECT_REF=

# Token personal de acceso. Solo para `supabase link` / `db push` desde tu equipo.
SUPABASE_ACCESS_TOKEN=

# Contraseña de la base. Solo para operaciones administrativas puntuales.
SUPABASE_DB_PASSWORD=
